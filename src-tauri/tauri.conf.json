{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Data Spine",
  "version": "0.2.0",
  "identifier": "com.tjord.personal-data-spine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Personal Data Spine",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480
      },
      {
        "label": "capture",
        "title": "Capture",
        "width": 440,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
